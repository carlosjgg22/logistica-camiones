# Copia este archivo como .env y completa con los datos de la app WEB de Firebase:
# Consola de Firebase > Configuración del proyecto > Tus apps > Agregar app > Web (</>).
# No uses la clave de la app Android: suele estar restringida a Android y el navegador no puede usarla.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=flota-despacho-3339.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=flota-despacho-3339
VITE_FIREBASE_APP_ID=
